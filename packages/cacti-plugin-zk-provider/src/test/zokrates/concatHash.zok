import "./stdlib/hashes/sha256/sha256Padded.zok" as sha256;
import "./stdlib/utils/casts/u16_to_u8array.zok" as cast_u16_u8;
import "./stdlib/utils/casts/field_to_u8.zok" as cast_field_u8;

def main(private u16[24] userAddress, private u16[33] blockParent, private u32[8] outsideHash) {
    u8[114] mut compactDataBytes = [0; 114];
    for u32 i in 0..24 {
        u8[2] part = cast_u16_u8(userAddress[i]);
        compactDataBytes[i*2] = part[0];
        compactDataBytes[i*2 + 1] = part[1];
    }
    for u32 j in 0..33 {
        u8[2] part2 = cast_u16_u8(blockParent[j]);
        compactDataBytes[48 + j*2] = part2[0];
        compactDataBytes[49 + j*2] = part2[1];
    }

    u32[8] dataHash = sha256(compactDataBytes);

    assert(dataHash[0] == outsideHash[0]);
    assert(dataHash[1] == outsideHash[1]);
    assert(dataHash[2] == outsideHash[2]);
    assert(dataHash[3] == outsideHash[3]);
    assert(dataHash[4] == outsideHash[4]);
    assert(dataHash[5] == outsideHash[5]);
    assert(dataHash[6] == outsideHash[6]);
    assert(dataHash[7] == outsideHash[7]);
}