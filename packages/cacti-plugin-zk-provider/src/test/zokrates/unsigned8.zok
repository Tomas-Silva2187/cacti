import "./stdlib/hashes/sha256/sha256Padded.zok" as sha256;
import "./stdlib/utils/casts/u16_to_u8array.zok" as cast_u16_u8;
import "./stdlib/utils/casts/field_to_u8.zok" as cast_field_u8;
import "./stdlib/utils/casts/u8_to_field.zok" as cast_u8_field;
import "./stdlib/signatures/verifyEddsa.zok" as check_babyjubjub_sign;
import "./stdlib/ecc/babyjubjubParams.zok" as babyjubjubparams;
from "./stdlib/ecc/babyjubjubParams.zok" import BabyJubJubParams;

def u8_array_to_field(u8[3] arr) -> field {
    field a0 = cast_u8_field(arr[0]);
    field a1 = cast_u8_field(arr[1]);
    field a2 = cast_u8_field(arr[2]);
    return a0 * 100 + a1 * 10 + a2;
}

const field THRESHOLD = 240;

const u8 VERSION = 49;

/*def main(u8[55] sessionId, u8[40] wrapperAddress, u8[40] gatewayAddress, private u8[64] txHash, private u8[3] ethTimestamp, private u8[3] systemTimestamp, private u32[8] secondHash, field[2] signR, field signS, field[2] signA) -> bool{
